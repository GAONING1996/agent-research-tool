# 调研工具配置示例 —— 复制为 .env 后按需填写；也可以不复制，用 `research doctor --json`
# 看缺什么，或用 `research setup --interactive` 让向导写到用户配置目录。
#
# 配置读取顺序：环境变量 > 项目 .env > 用户配置 > 默认值。
# 用户配置文件位置：Windows %LOCALAPPDATA%\research-tool\config.env；Linux/macOS ~/.local/share/research-tool/config.env

# ---------- 必填（至少一个搜索提供方） ----------
# Tavily 搜索 API key，注册地址 https://tavily.com
TAVILY_API_KEY=
# 或者自建 SearXNG，二选一即可
# SEARXNG_URL=http://127.0.0.1:8080

# ---------- 可选：各类增强能力，缺了自动降级 ----------
# 视频/播客/长音频转写（Groq Whisper），注册地址 https://console.groq.com
GROQ_API_KEY=
# 识图兜底（Agnes）
AGNES_API_KEY=
# 正文抽取增强：需自行部署 Open Notebook（https://github.com/lfnovo/open-notebook），本仓库不含它的数据与凭据
# OPEN_NOTEBOOK_URL=http://127.0.0.1:5055
# Jina Reader key，Open Notebook 内部使用，注册地址 https://jina.ai/api-dashboard/
# JINA_API_KEY=

# ---------- 可选：网络 ----------
# 访问境外源（YouTube、Groq、Jina）时使用的代理；留空表示不走代理
# RESEARCH_PROXY=http://127.0.0.1:7897

# ---------- 可选：外部程序路径（默认从 PATH 查找） ----------
# OPENCLI_PATH=
# YT_DLP_PATH=
# BILI_PATH=
# CHROME_PATH=

# ---------- 可选：数据目录 ----------
# 状态文件、锁文件、Notebook 临时状态默认放用户数据目录，不放安装目录
# RESEARCH_DATA_DIR=
# RESEARCH_CONFIG=
